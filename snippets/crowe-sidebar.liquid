<!-- Enhanced Crowe Logic AI Integration Script -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Trophy Section AI Controls
  const voiceBtn = document.getElementById('croweVoiceBtn');
  const chatBtn = document.getElementById('croweChatBtn');
  const researchBtn = document.getElementById('croweResearchBtn');
  const chatContainer = document.getElementById('trophyChatContainer');
  const scrollToTrophyBtn = document.getElementById('scrollToTrophy');
  const trophySection = document.querySelector('.crowe-trophy-section');
  
  // Voice Chat Functionality
  if (voiceBtn) {
    voiceBtn.addEventListener('click', function() {
      // Add visual feedback
      this.classList.add('control-btn-active');
      
      // Simulate voice activation (integrate with your voice API)
      setTimeout(() => {
        this.classList.remove('control-btn-active');
        // Open voice interface or trigger voice commands
        if (window.croweVoiceAI) {
          window.croweVoiceAI.startListening();
        } else {
          // Fallback: Open external assistant
          window.open('https://research-assistant-ce196c.zapier.app', '_blank');
        }
      }, 300);
    });
  }
  
  // Chat Toggle Functionality
  if (chatBtn && chatContainer) {
    chatBtn.addEventListener('click', function() {
      this.classList.toggle('control-btn-active');
      chatContainer.classList.toggle('chat-container-expanded');
      
      // Scroll to make sure chat is visible
      if (chatContainer.classList.contains('chat-container-expanded')) {
        chatContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  }
  
  // Research Mode Toggle
  if (researchBtn) {
    researchBtn.addEventListener('click', function() {
      this.classList.toggle('control-btn-active');
      
      // Add research mode visual effects
      trophySection?.classList.toggle('research-mode-active');
      
      // Could integrate with AI to switch to research mode
      console.log('Research mode toggled');
    });
  }
  
  // Scroll to Trophy Section
  if (scrollToTrophyBtn && trophySection) {
    scrollToTrophyBtn.addEventListener('click', function() {
      trophySection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      
      // Highlight the trophy section briefly
      trophySection.classList.add('trophy-highlighted');
      setTimeout(() => {
        trophySection.classList.remove('trophy-highlighted');
      }, 2000);
    });
  }
  
  // Neural Network Animation
  function animateNeuralNodes() {
    const nodes = document.querySelectorAll('.neural-node');
    const connections = document.querySelectorAll('.neural-connection');
    
    nodes.forEach((node, index) => {
      node.style.animationDelay = `${index * 0.5}s`;
    });
    
    connections.forEach((connection, index) => {
      connection.style.animationDelay = `${index * 0.7}s`;
    });
  }
  
  // Initialize neural network animation
  animateNeuralNodes();
  
  // Avatar breathing animation
  const trophyAvatar = document.querySelector('.trophy-avatar');
  if (trophyAvatar) {
    setInterval(() => {
      trophyAvatar.classList.add('avatar-breath');
      setTimeout(() => {
        trophyAvatar.classList.remove('avatar-breath');
      }, 2000);
    }, 4000);
  }
  
  // Status indicator pulsing
  const statusDot = document.querySelector('.status-dot');
  if (statusDot) {
    setInterval(() => {
      statusDot.classList.add('status-pulse');
      setTimeout(() => {
        statusDot.classList.remove('status-pulse');
      }, 1000);
    }, 3000);
  }
});
</script>

