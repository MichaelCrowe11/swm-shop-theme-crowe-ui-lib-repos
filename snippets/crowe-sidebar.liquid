<!-- Enhanced Crowe Logic AI Integration Script -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Research Console Controls
  const voiceBtn = document.getElementById('croweVoiceBtn');
  const chatBtn = document.getElementById('croweChatBtn');
  const researchBtn = document.getElementById('croweResearchBtn');
  const researchConsole = document.querySelector('.crowe-research-console');
  const chatInterface = document.getElementById('researchChatInterface');
  const scrollToTrophyBtn = document.getElementById('scrollToTrophy');
  const trophySection = document.querySelector('.crowe-trophy-section');
  
  // Voice Chat Functionality
  if (voiceBtn) {
    voiceBtn.addEventListener('click', function() {
      // Remove active state from other buttons
      document.querySelectorAll('.control-btn-compact').forEach(btn => btn.classList.remove('active'));
      this.classList.add('active');
      
      // Add visual feedback
      this.style.transform = 'scale(0.95)';
      setTimeout(() => {
        this.style.transform = 'scale(1)';
        
        // Open voice interface or trigger voice commands
        if (window.croweVoiceAI) {
          window.croweVoiceAI.startListening();
        } else {
          // Fallback: Open external assistant
          window.open('https://research-assistant-ce196c.zapier.app', '_blank');
        }
      }, 150);
    });
  }
  
  // Chat Mode (Default Active)
  if (chatBtn) {
    chatBtn.addEventListener('click', function() {
      document.querySelectorAll('.control-btn-compact').forEach(btn => btn.classList.remove('active'));
      this.classList.add('active');
      
      // Ensure chat interface is visible and focused
      if (chatInterface) {
        chatInterface.style.opacity = '1';
        chatInterface.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  }
  
  // Research Mode Toggle
  if (researchBtn) {
    researchBtn.addEventListener('click', function() {
      document.querySelectorAll('.control-btn-compact').forEach(btn => btn.classList.remove('active'));
      this.classList.add('active');
      
      // Add research mode visual effects
      researchConsole?.classList.toggle('research-mode-enhanced');
      
      // Update console title
      const consoleTitle = document.querySelector('.console-title h2');
      if (consoleTitle) {
        consoleTitle.textContent = this.classList.contains('active') ? 'Deep Research Mode' : 'Research Console';
      }
    });
  }
  
  // Scroll to Trophy Section (from footer)
  if (scrollToTrophyBtn && trophySection) {
    scrollToTrophyBtn.addEventListener('click', function() {
      trophySection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      
      // Highlight the trophy section briefly
      trophySection.classList.add('trophy-highlighted');
      setTimeout(() => {
        trophySection.classList.remove('trophy-highlighted');
      }, 2000);
    });
  }
  
  // Neural Network Animation (simplified for compact design)
  function animateNeuralNodes() {
    const nodes = document.querySelectorAll('.neural-node');
    const connections = document.querySelectorAll('.neural-connection');
    
    nodes.forEach((node, index) => {
      node.style.animationDelay = `${index * 0.3}s`;
    });
    
    connections.forEach((connection, index) => {
      connection.style.animationDelay = `${index * 0.5}s`;
    });
  }
  
  // Initialize animations
  animateNeuralNodes();
  
  // Avatar breathing animation (subtle)
  const trophyAvatar = document.querySelector('.trophy-avatar');
  if (trophyAvatar) {
    setInterval(() => {
      trophyAvatar.style.transform = 'scale(1.02)';
      setTimeout(() => {
        trophyAvatar.style.transform = 'scale(1)';
      }, 1000);
    }, 5000);
  }
  
  // Status indicator pulsing for console
  const statusIndicator = document.querySelector('.status-indicator');
  if (statusIndicator) {
    setInterval(() => {
      statusIndicator.style.opacity = '0.5';
      setTimeout(() => {
        statusIndicator.style.opacity = '1';
      }, 500);
    }, 2000);
  }
  
  // Auto-focus chat interface on load
  setTimeout(() => {
    if (chatInterface) {
      chatInterface.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }, 1000);
});
</script>

