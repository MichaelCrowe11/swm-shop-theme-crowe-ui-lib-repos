{% comment %}
  Enhanced Quantum Product Card with Visual Effects
  Usage: {% render 'crowe-product-card-quantum-enhanced', product: product %}
{% endcomment %}

{{ 'crowe-visual-effects-master.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .quantum-product-card-enhanced {
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 24px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    max-width: 400px;
    margin: 0 auto;
  }

  .quantum-product-card-enhanced::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: conic-gradient(from 0deg at 50% 50%, 
      transparent 0deg, 
      rgba(212, 175, 55, 0.05) 60deg, 
      transparent 120deg,
      rgba(255, 215, 0, 0.03) 180deg,
      transparent 240deg,
      rgba(212, 175, 55, 0.05) 300deg,
      transparent 360deg);
    animation: quantum-card-rotation 12s linear infinite;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .quantum-product-card-enhanced:hover {
    transform: translateY(-12px) rotateX(5deg);
    box-shadow: 
      0 25px 50px rgba(0, 0, 0, 0.3),
      0 0 60px rgba(212, 175, 55, 0.25);
    border-color: rgba(212, 175, 55, 0.6);
  }

  .quantum-product-card-enhanced:hover::before {
    opacity: 1;
  }

  @keyframes quantum-card-rotation {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .quantum-card-media {
    position: relative;
    overflow: hidden;
    border-radius: 20px 20px 0 0;
    height: 280px;
  }

  .quantum-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    filter: contrast(1.1) saturate(1.1);
  }

  .quantum-product-card-enhanced:hover .quantum-card-image {
    transform: scale(1.1) rotate(2deg);
    filter: contrast(1.2) saturate(1.3) brightness(1.05);
  }

  .quantum-card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, 
      transparent 0%, 
      rgba(212, 175, 55, 0.1) 50%, 
      transparent 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .quantum-product-card-enhanced:hover .quantum-card-overlay {
    opacity: 1;
  }

  .quantum-card-badges {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 5;
  }

  .quantum-badge {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    animation: quantum-badge-pulse 2s ease-in-out infinite;
  }

  .quantum-badge--sale {
    background: linear-gradient(135deg, #ff4757, #ff3742);
    color: white;
  }

  .quantum-badge--new {
    background: linear-gradient(135deg, #5352ed, #3742fa);
    color: white;
  }

  .quantum-badge--featured {
    background: linear-gradient(135deg, #D4AF37, #B8943F);
    color: #000;
  }

  @keyframes quantum-badge-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  .quantum-card-content {
    padding: 24px;
    position: relative;
    z-index: 3;
  }

  .quantum-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 8px;
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .quantum-product-card-enhanced:hover .quantum-card-title {
    background: var(--gradient-quantum-text);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: quantum-title-shimmer 3s ease-in-out infinite;
  }

  @keyframes quantum-title-shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .quantum-card-price {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .quantum-price-current {
    font-size: 1.5rem;
    font-weight: 900;
    color: #D4AF37;
    text-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
  }

  .quantum-price-compare {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: line-through;
  }

  .quantum-card-description {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 20px;
  }

  .quantum-card-actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .quantum-add-to-cart {
    flex: 1;
    background: linear-gradient(135deg, #D4AF37, #B8943F);
    color: #000;
    border: none;
    border-radius: 12px;
    padding: 12px 20px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .quantum-add-to-cart::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.4) 0%, transparent 70%);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }

  .quantum-add-to-cart:hover::before {
    width: 200px;
    height: 200px;
  }

  .quantum-add-to-cart:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(212, 175, 55, 0.4);
  }

  .quantum-quick-actions {
    display: flex;
    gap: 8px;
  }

  .quantum-quick-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .quantum-quick-btn:hover {
    background: rgba(212, 175, 55, 0.2);
    border-color: rgba(212, 175, 55, 0.4);
    transform: scale(1.1) rotate(5deg);
  }

  .quantum-floating-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .quantum-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: radial-gradient(circle, #D4AF37 0%, transparent 70%);
    border-radius: 50%;
    animation: quantum-particle-float 6s linear infinite;
  }

  .quantum-particle:nth-child(1) { animation-delay: 0s; top: 20%; left: 10%; }
  .quantum-particle:nth-child(2) { animation-delay: -2s; top: 60%; right: 15%; }
  .quantum-particle:nth-child(3) { animation-delay: -4s; bottom: 30%; left: 20%; }

  @keyframes quantum-particle-float {
    0%, 100% { 
      transform: translateY(0px) scale(1); 
      opacity: 0.3; 
    }
    50% { 
      transform: translateY(-20px) scale(1.2); 
      opacity: 0.8; 
    }
  }

  @media (max-width: 768px) {
    .quantum-product-card-enhanced:hover {
      transform: translateY(-6px) rotateX(2deg);
    }
    
    .quantum-card-media {
      height: 240px;
    }
    
    .quantum-card-content {
      padding: 20px;
    }
  }
{%- endstyle -%}

<div class="quantum-product-card-enhanced">
  <!-- Floating Particles -->
  <div class="quantum-floating-particles">
    <div class="quantum-particle"></div>
    <div class="quantum-particle"></div>
    <div class="quantum-particle"></div>
  </div>

  <!-- Card Media -->
  <div class="quantum-card-media">
    <img src="{{ product.featured_image | image_url: width: 400 }}" 
         alt="{{ product.featured_image.alt | escape }}"
         class="quantum-card-image"
         loading="lazy">
    
    <!-- Hover Overlay -->
    <div class="quantum-card-overlay"></div>
    
    <!-- Badges -->
    <div class="quantum-card-badges">
      {% if product.compare_at_price > product.price %}
        <span class="quantum-badge quantum-badge--sale">Sale</span>
      {% endif %}
      {% if product.created_at > "now" | date: "%s" | minus: 2629746 %}
        <span class="quantum-badge quantum-badge--new">New</span>
      {% endif %}
      {% if product.tags contains 'featured' %}
        <span class="quantum-badge quantum-badge--featured">Featured</span>
      {% endif %}
    </div>
  </div>

  <!-- Card Content -->
  <div class="quantum-card-content">
    <h3 class="quantum-card-title">{{ product.title | truncate: 50 }}</h3>
    
    <!-- Price -->
    <div class="quantum-card-price">
      <span class="quantum-price-current">
        {{ product.price | money }}
      </span>
      {% if product.compare_at_price > product.price %}
        <span class="quantum-price-compare">
          {{ product.compare_at_price | money }}
        </span>
      {% endif %}
    </div>

    <!-- Description -->
    {% if product.description != blank %}
      <p class="quantum-card-description">
        {{ product.description | strip_html | truncate: 100 }}
      </p>
    {% endif %}

    <!-- Actions -->
    <div class="quantum-card-actions">
      <form action="/cart/add" method="post" enctype="multipart/form-data" class="quantum-add-form">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="quantum-add-to-cart">
          Add to Cart
        </button>
      </form>
      
      <div class="quantum-quick-actions">
        <button class="quantum-quick-btn" title="Quick View" data-product-id="{{ product.id }}" aria-label="Quick view {{ product.title }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
          </svg>
        </button>
        
        <button class="quantum-quick-btn" title="Add to Wishlist" data-product-id="{{ product.id }}" aria-label="Add {{ product.title }} to wishlist">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Enhanced add to cart functionality
  const addToCartForms = document.querySelectorAll('.quantum-add-form');
  
  addToCartForms.forEach(form => {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const button = form.querySelector('.quantum-add-to-cart');
      const originalText = button.textContent;
      
      // Visual feedback
      button.textContent = 'Adding...';
      button.disabled = true;
      button.style.background = 'linear-gradient(135deg, #5dade2, #3498db)';
      button.style.cursor = 'not-allowed';
      
      // Simulate add to cart (replace with actual Shopify cart API)
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: new URLSearchParams(new FormData(form))
      })
      .then(response => {
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
      })
      .then(data => {
        // Success feedback
        button.textContent = 'Added!';
        button.style.background = 'linear-gradient(135deg, #27ae60, #2ecc71)';
        
        // Trigger cart update event
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
        
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
          button.style.background = '';
          button.style.cursor = '';
        }, 2000);
      })
      .catch(error => {
        console.error('Add to cart error:', error);
        // Error feedback
        button.textContent = 'Try Again';
        button.style.background = 'linear-gradient(135deg, #e74c3c, #c0392b)';
        
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
          button.style.background = '';
          button.style.cursor = '';
        }, 2000);
      });
    });
  });

  // Quick view functionality
  const quickViewBtns = document.querySelectorAll('[data-product-id]');
  
  quickViewBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const productId = this.getAttribute('data-product-id');
      
      // Add visual feedback
      this.style.transform = 'scale(0.95)';
      
      setTimeout(() => {
        this.style.transform = '';
      }, 150);
      
      // Implement quick view modal here
      console.log('Quick view for product:', productId);
    });
  });
});
</script>
