{{ 'crowe-research-console.css' | asset_url | stylesheet_tag }}

<aside class="crowe-research-station" id="crowe-sidebar" role="navigation" aria-label="Crowe Research Station">
  <!-- Station Header with App-Style Logo -->
  <div class="station-header">
    <div class="station-title">
      <div class="station-logo">
        <div class="logo-icon">
          <div class="neural-core"></div>
          <div class="neural-ring"></div>
          <div class="neural-pulse"></div>
        </div>
      </div>
      <h1 class="station-brand">Crowe Research Station</h1>
    </div>
    
    <!-- Premium Size Control Panel -->
    <div class="sidebar-size-controls" aria-label="Sidebar Size Controls">
      <button class="size-option" data-size="mini" aria-label="Extra Small Size">XS</button>
      <button class="size-option active" data-size="compact" aria-label="Small Size">S</button>
      <button class="size-option" data-size="standard" aria-label="Medium Size">M</button>
      <button class="size-option" data-size="large" aria-label="Large Size">L</button>
      <button class="size-option" data-size="full" aria-label="Extra Large Size">XL</button>
    </div>
  </div>

  <!-- Smartphone-Style Research Console -->
  <div class="station-content">
    <div class="crowe-research-console">
      <!-- Main Research Interface -->
      <div class="research-interface">
        <!-- Crowe Avatar Section -->
        <div class="crowe-avatar-section">
          <div class="avatar-container">
            <img src="{{ 'crowe-avatar.png' | asset_url }}" alt="Crowe Logic AI Avatar" class="crowe-avatar">
            <div class="avatar-glow"></div>
            <div class="neural-connections">
              <div class="neural-node node-1"></div>
              <div class="neural-node node-2"></div>
              <div class="neural-node node-3"></div>
            </div>
          </div>
          <h2 class="avatar-title">Crowe Logic AI</h2>
          <p class="avatar-status">Research Station Active</p>
        </div>

        <!-- Research Controls -->
        <div class="research-controls">
          <button class="control-button primary" id="croweVoiceBtn" aria-label="Voice Research">
            <span class="button-icon">🎤</span>
            <span class="button-text">Voice Query</span>
          </button>
          
          <button class="control-button secondary" id="croweChatBtn" aria-label="Text Research">
            <span class="button-icon">💬</span>
            <span class="button-text">Text Chat</span>
          </button>
          
          <button class="control-button accent" id="croweResearchBtn" aria-label="Research Mode">
            <span class="button-icon">🔬</span>
            <span class="button-text">Research</span>
          </button>
        </div>

        <!-- Quick Actions -->
        <div class="quick-actions">
          <a href="{{ routes.root_url }}" class="action-link">
            <span class="action-icon">🌿</span>
            <span class="action-text">Dashboard</span>
          </a>
          
          <a href="{{ routes.collections_url }}" class="action-link">
            <span class="action-icon">📦</span>
            <span class="action-text">Products</span>
          </a>
          
          <a href="/pages/crowe-logic" class="action-link">
            <span class="action-icon">🤖</span>
            <span class="action-text">AI Hub</span>
          </a>
          
          <a href="{{ routes.cart_url }}" class="action-link" id="cart-link">
            <span class="action-icon">🛒</span>
            <span class="action-text">Cart</span>
            <span class="cart-badge" id="cart-count">{{ cart.item_count }}</span>
          </a>
        </div>

        <!-- Trophy Integration -->
        <div class="trophy-integration">
          <button class="trophy-button" id="scrollToTrophy" aria-label="Scroll to trophy showcase section">
            <span class="trophy-icon" aria-hidden="true">🏆</span>
            <span class="trophy-text">Trophy Showcase</span>
          </button>
        </div>
      </div>

      <!-- Research Chat Interface -->
      <div class="research-chat-interface" id="researchChatInterface" style="display: none;" role="dialog" aria-labelledby="chat-title" aria-hidden="true">
        <div class="chat-header">
          <h3 id="chat-title">Research Console</h3>
          <button class="chat-close" id="closeChatBtn" aria-label="Close chat interface">×</button>
        </div>
        <div class="chat-messages" id="chatMessages" role="log" aria-live="polite" aria-label="Chat conversation">
          <div class="chat-message system">
            <div class="message-avatar" aria-hidden="true">🤖</div>
            <div class="message-content">
              <p>Welcome to Crowe Research Station. How can I assist your research today?</p>
            </div>
          </div>
        </div>
        <div class="chat-input-area">
          <label for="chatInput" class="visually-hidden">Research query input</label>
          <input type="text" id="chatInput" placeholder="Ask Crowe anything..." aria-describedby="chat-help">
          <button id="sendChatBtn" aria-label="Send message">
            <span class="send-icon" aria-hidden="true">➤</span>
          </button>
          <div id="chat-help" class="visually-hidden">Enter your research question and press Enter or click send</div>
        </div>
      </div>
    </div>
  </div>
</aside>

<!-- Crowe Logic AI Integration Script -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const researchStation = document.querySelector('.crowe-research-station');
  const sizeOptions = document.querySelectorAll('.size-option');
  const sidebar = document.getElementById('crowe-sidebar');
  
  function initializeSizeControls() {
    sizeOptions.forEach(option => {
      option.addEventListener('click', function() {
        const size = this.dataset.size;
        
        sizeOptions.forEach(opt => opt.classList.remove('active'));
        this.classList.add('active');
        
        researchStation.classList.remove('size-mini', 'size-compact', 'size-standard', 'size-large', 'size-full');
        researchStation.classList.add(`size-${size}`);
        
        localStorage.setItem('crowe-sidebar-size', size);
        
        researchStation.style.transform = 'scale(0.95)';
        setTimeout(() => {
          researchStation.style.transform = '';
        }, 150);
      });
    });
    
    const savedSize = localStorage.getItem('crowe-sidebar-size');
    if (savedSize) {
      const savedOption = document.querySelector(`[data-size="${savedSize}"]`);
      if (savedOption) savedOption.click();
    }
  }
  
  function handleMainContentInteraction() {
    const mainContent = document.querySelector('main, .main-content, #MainContent');
    if (!mainContent) return;
    
    let hideTimeout;
    
    mainContent.addEventListener('mouseenter', () => {
      if (window.innerWidth > 1200) {
        hideTimeout = setTimeout(() => {
          sidebar.classList.add('sidebar-auto-hide');
        }, 500);
      }
    });
    
    mainContent.addEventListener('mouseleave', () => {
      clearTimeout(hideTimeout);
      sidebar.classList.remove('sidebar-auto-hide');
    });
    
    sidebar.addEventListener('mouseenter', () => {
      clearTimeout(hideTimeout);
      sidebar.classList.remove('sidebar-auto-hide');
    });
  }
  
  initializeSizeControls();
  handleMainContentInteraction();
  const voiceBtn = document.getElementById('croweVoiceBtn');
  const chatBtn = document.getElementById('croweChatBtn');
  const researchBtn = document.getElementById('croweResearchBtn');
  const researchConsole = document.querySelector('.crowe-research-console');
  const chatInterface = document.getElementById('researchChatInterface');
  const scrollToTrophyBtn = document.getElementById('scrollToTrophy');

  if (voiceBtn) {
    voiceBtn.addEventListener('click', function() {
      this.classList.add('active');
      setTimeout(() => this.classList.remove('active'), 2000);
    });
  }

  if (chatBtn) {
    chatBtn.addEventListener('click', function() {
      if (chatInterface) {
        chatInterface.style.display = chatInterface.style.display === 'none' ? 'block' : 'none';
      }
    });
  }

  if (researchBtn) {
    researchBtn.addEventListener('click', function() {
      researchConsole?.classList.toggle('research-mode-active');
    });
  }

  if (scrollToTrophyBtn) {
    scrollToTrophyBtn.addEventListener('click', function() {
      const trophySection = document.querySelector('.crowe-trophy-section, #trophy-section, [data-trophy]');
      if (trophySection) {
        trophySection.scrollIntoView({ 
          behavior: 'smooth',
          block: 'center'
        });
      }
    });
  }

  const chatInput = document.getElementById('chatInput');
  const sendChatBtn = document.getElementById('sendChatBtn');
  const chatMessages = document.getElementById('chatMessages');
  const closeChatBtn = document.getElementById('closeChatBtn');

  if (sendChatBtn && chatInput && chatMessages) {
    function sendMessage() {
      const message = chatInput.value.trim();
      if (!message) return;
      
      const userMsg = document.createElement('div');
      userMsg.className = 'chat-message user';
      userMsg.innerHTML = `
        <div class="message-avatar" aria-hidden="true">👤</div>
        <div class="message-content"><p>${message}</p></div>
      `;
      chatMessages.appendChild(userMsg);
      chatInput.value = '';

      setTimeout(() => {
        const aiMsg = document.createElement('div');
        aiMsg.className = 'chat-message system';
        aiMsg.innerHTML = `
          <div class="message-avatar" aria-hidden="true">🤖</div>
          <div class="message-content"><p>Research query received: "${message}". Processing your request...</p></div>
        `;
        chatMessages.appendChild(aiMsg);
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }, 1000);
      
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    sendChatBtn.addEventListener('click', sendMessage);
    chatInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') sendMessage();
    });
  }

  closeChatBtn?.addEventListener('click', function() {
    if (chatInterface) chatInterface.style.display = 'none';
  });
});
</script>

<style>
.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}
</style>
