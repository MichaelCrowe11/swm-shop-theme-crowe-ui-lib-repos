<!-- Mobile Sidebar Toggle -->
<button class="mobile-sidebar-toggle quantum-clickable quantum-glow-hover" id="mobile-sidebar-toggle" aria-label="Open navigation menu">
  <span class="hamburger-line"></span>
  <span class="hamburger-line"></span>
  <span class="hamburger-line"></span>
</button>

<!-- Sidebar Overlay for Mobile -->
<div class="sidebar-overlay" id="sidebar-overlay"></div>

<!-- Combined JavaScript for All Features -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Sidebar elements
  const sidebar = document.getElementById('crowe-sidebar');
  const mobileToggle = document.getElementById('mobile-sidebar-toggle');
  const sidebarToggle = document.querySelector('.sidebar-toggle');
  const overlay = document.getElementById('sidebar-overlay');
  
  // Size controls
  const sizeOptions = document.querySelectorAll('.size-option');
  
  // Chat elements
  const chatToggle = document.getElementById('chat-toggle');
  const chatContent = document.getElementById('chat-content');
  const expandIcon = chatToggle?.querySelector('.chat-expand-icon svg path');
  
  // Control buttons
  const voiceBtn = document.getElementById('croweVoiceBtn');
  const chatBtn = document.getElementById('croweChatBtn');
  const researchBtn = document.getElementById('croweResearchBtn');
  
  // Size control functionality
  if (sizeOptions.length > 0) {
    sizeOptions.forEach(option => {
      option.addEventListener('click', function() {
        const size = this.dataset.size;
        
        sizeOptions.forEach(opt => opt.classList.remove('active'));
        this.classList.add('active');
        
        sidebar.classList.remove('size-mini', 'size-compact', 'size-standard', 'size-large', 'size-full');
        sidebar.classList.add(`size-${size}`);
        
        localStorage.setItem('crowe-sidebar-size', size);
        
        // Trigger resize event for quantum effects
        window.dispatchEvent(new Event('resize'));
      });
    });
    
    // Load saved size
    const savedSize = localStorage.getItem('crowe-sidebar-size');
    if (savedSize) {
      const savedOption = document.querySelector(`[data-size="${savedSize}"]`);
      if (savedOption) savedOption.click();
    }
  }
  
  // Mobile functionality
  function isMobile() {
    return window.innerWidth <= 768;
  }
  
  function toggleSidebar() {
    sidebar.classList.toggle('sidebar-open');
    overlay.classList.toggle('overlay-active');
    document.body.classList.toggle('sidebar-is-open');
  }
  
  function closeSidebar() {
    sidebar.classList.remove('sidebar-open');
    overlay.classList.remove('overlay-active');
    document.body.classList.remove('sidebar-is-open');
  }
  
  if (mobileToggle) {
    mobileToggle.addEventListener('click', toggleSidebar);
  }
  
  if (sidebarToggle) {
    sidebarToggle.addEventListener('click', closeSidebar);
  }
  
  if (overlay) {
    overlay.addEventListener('click', closeSidebar);
  }
  
  // Chat toggle functionality
  const chatContainer = document.getElementById('crowe-chat-container');
  if (chatToggle && chatContainer) {
    chatToggle.addEventListener('click', function() {
      const isExpanded = chatContainer.classList.contains('chat-expanded');
      
      if (isExpanded) {
        chatContainer.classList.remove('chat-expanded');
        chatToggle.setAttribute('aria-expanded', 'false');
        if (expandIcon) expandIcon.setAttribute('d', 'M6 9L12 15L18 9');
      } else {
        chatContainer.classList.add('chat-expanded');
        chatToggle.setAttribute('aria-expanded', 'true');
        if (expandIcon) expandIcon.setAttribute('d', 'M18 15L12 9L6 15');
      }
    });
    
    chatToggle.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        chatToggle.click();
      }
    });
  }
  
  // Control button handlers
  if (voiceBtn) {
    voiceBtn.addEventListener('click', function() {
      console.log('🎤 Voice control activated');
      // Add voice functionality here
    });
  }
  
  if (chatBtn) {
    chatBtn.addEventListener('click', function() {
      if (chatToggle) chatToggle.click();
    });
  }
  
  if (researchBtn) {
    researchBtn.addEventListener('click', function() {
      window.open('https://research-assistant-ce196c.zapier.app', '_blank');
    });
  }
  
  // Escape key handler
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeSidebar();
    }
  });
  
  // Handle window resize
  window.addEventListener('resize', function() {
    if (!isMobile()) {
      closeSidebar();
    }
  });
  
  // Initialize mobile state
  if (isMobile()) {
    sidebar.classList.add('mobile-sidebar');
  }
  
  console.log('🚀 Crowe Research Station Quantum loaded');
});
</script>