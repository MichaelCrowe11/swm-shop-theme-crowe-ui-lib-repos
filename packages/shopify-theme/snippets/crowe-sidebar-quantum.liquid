<!-- Crowe AI Settings Configuration -->
<script>
  window.croweSettings = {
    apiKey: '{{ settings.xai_api_key }}',
    model: '{{ settings.crowe_ai_model | default: "grok-beta" }}',
    chatEnabled: {{ settings.crowe_chat_enabled | default: true }},
    voiceInput: {{ settings.crowe_voice_enabled | default: true }},
    imageGeneration: {{ settings.crowe_image_generation | default: false }},
    documentGeneration: {{ settings.crowe_document_generation | default: true }},
    productSearch: {{ settings.crowe_product_search | default: true }},
    codeExecution: {{ settings.crowe_code_execution | default: false }},
    chatHeight: {{ settings.crowe_chat_height | default: 400 }},
    systemPrompt: '{{ settings.crowe_system_prompt | default: "You are Crowe Logic AI, a helpful shopping and research assistant for Southwest Mushrooms." | escape }}'
  };
</script>

